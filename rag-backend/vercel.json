{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{tests/**,__pycache__/**,.pytest_cache/**,.venv/**,data/**,scripts/**,test_*.py,*.log}"
    }
  }
}
